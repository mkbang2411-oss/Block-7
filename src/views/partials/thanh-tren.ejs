<%# thanh nút phía trên: Ra phố | (tuỳ trang) | Đăng nhập/Đăng xuất %>
<div class="thanh">
  <a class="nut nut-phu" href="/">Ra phố</a>
  <div class="tabs">
    <% if (locals.tabs) { tabs.forEach(function (t) { %>
      <a class="nut tab<%= t.on ? ' on' : '' %>" href="<%= t.href %>"><%= t.label %></a>
    <% }) } %>
  </div>
  <div class="tabs">
    <% if (locals.themHref) { %><a class="nut" href="<%= themHref %>"><%= themLabel %></a><% } %>
    <% if (role) { %>
      <form method="post" action="/logout" class="form-tran"><button class="nut nut-phu">Đăng xuất (<%= role === 'admin' ? 'đầu bếp' : 'khách' %>)</button></form>
    <% } else { %>
      <a class="nut nut-phu" href="/login">Đăng nhập</a>
    <% } %>
  </div>
</div>
